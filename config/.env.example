# ECS Auto-Restart Configuration Template
# Copy this file to create environment-specific configs
# Example: cp .env.example production.env

# Stack Configuration
STACK_NAME="ecs-autorestart-prod"           # CloudFormation stack name
AWS_REGION="ap-southeast-1"                 # AWS region

# S3 Configuration
S3_BUCKET="your-lambda-bucket-name"         # S3 bucket for Lambda deployment packages
S3_KEY="ecs-auto-restart/lambda.zip"       # S3 key/path for Lambda zip file

# IAM Configuration
LAMBDA_ROLE_ARN="arn:aws:iam::ACCOUNT_ID:role/YOUR-LAMBDA-ROLE"  # IAM role ARN for Lambda execution

# ECS Configuration
ECS_CLUSTER_NAME="your-ecs-cluster"         # ECS cluster to monitor
ECS_SERVICE_NAMES="service1,service2"       # Comma-separated list of services to monitor

# Lambda Configuration
DESIRED_TASK_COUNT="1"                      # Number of tasks to start when restarting
MONITORING_SCHEDULE="rate(30 minutes)"      # How often to check services (15min, 30min, 1hr, 2hr)

# Notification Configuration
ALERT_EMAIL="ops-team@example.com"          # Email for restart notifications (leave empty to disable)
ENVIRONMENT="production"                    # Environment tag (production, staging, development)

# ============================================================================
# INSTRUCTIONS:
# ============================================================================
# 1. Copy this file: cp .env.example production.env
# 2. Replace all placeholder values with your actual values
# 3. NEVER commit the actual .env files to git
# 4. Deploy using: ./scripts/deploy-env.sh production
# ============================================================================

# Common Configuration Examples:
# -----------------------------
# Production:
#   STACK_NAME="ecs-autorestart-prod"
#   MONITORING_SCHEDULE="rate(30 minutes)"
#   DESIRED_TASK_COUNT="2"
#   ENVIRONMENT="production"
#
# Staging:
#   STACK_NAME="ecs-autorestart-staging"
#   MONITORING_SCHEDULE="rate(1 hour)"
#   DESIRED_TASK_COUNT="1"
#   ENVIRONMENT="staging"
#
# Development:
#   STACK_NAME="ecs-autorestart-dev"
#   MONITORING_SCHEDULE="rate(2 hours)"
#   DESIRED_TASK_COUNT="1"
#   ENVIRONMENT="development"